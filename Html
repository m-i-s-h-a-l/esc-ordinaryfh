  <!-- SCRIPTS: CYBERPUNK CITYSCAPE + FULL 60FPS BATTLE ROYALE ENGINE        -->

  <!-- ===================================================================== -->

  <script>

    // -----------------------------------------------------------------------

    // 1. Navigation Drawer & Portal Modals (Lobby, Tournament, Season Pass)

    // -----------------------------------------------------------------------

    const menuToggleBtn = document.getElementById('menuToggleBtn');

    const menuCloseBtn = document.getElementById('menuCloseBtn');

    const navDrawer = document.getElementById('navDrawer');

    const navBackdrop = document.getElementById('navBackdrop');

    const navLinks = document.querySelectorAll('.nav-link');
    let seasonPassUnlocked = false;

    let activeLobbyMode = 'NEON SYNDICATE';

    let lobbyTimer = null;
    function openDrawer() {

      navBackdrop.classList.remove('hidden');

      requestAnimationFrame(() => {

        navBackdrop.classList.remove('opacity-0');

        navDrawer.classList.remove('translate-x-full');

        navDrawer.setAttribute('aria-hidden', 'false');

      });

    }
    function closeDrawer() {

      navBackdrop.classList.add('opacity-0');

      navDrawer.classList.add('translate-x-full');

      navDrawer.setAttribute('aria-hidden', 'true');

      setTimeout(() => {

        navBackdrop.classList.add('hidden');

      }, 300);

    }
    menuToggleBtn.addEventListener('click', openDrawer);

    menuCloseBtn.addEventListener('click', closeDrawer);

    navBackdrop.addEventListener('click', closeDrawer);

    navLinks.forEach(link => link.addEventListener('click', closeDrawer));
    function openLobbyModal(title, desc = 'Connecting to Low-Latency Arena Server...') {

      activeLobbyMode = title;

      document.getElementById('lobbyTitle').textContent = title;

      document.getElementById('lobbyDesc').textContent = desc;

      document.getElementById('lobbyModal').classList.remove('hidden');
      let count = 14;

      const countEl = document.getElementById('lobbyCountText');

      const barEl = document.getElementById('lobbyProgressBar');

      const statusEl = document.getElementById('lobbyStatusText');

      countEl.textContent = `${count} / 20`;

      barEl.style.width = `${(count / 20) * 100}%`;

      statusEl.textContent = 'Finding Contenders...';
      clearInterval(lobbyTimer);

      lobbyTimer = setInterval(() => {

        count++;

        if (count >= 20) {

          count = 20;

          clearInterval(lobbyTimer);

          statusEl.textContent = 'Match Ready!';

        }

        countEl.textContent = `${count} / 20`;

        barEl.style.width = `${(count / 20) * 100}%`;

      }, 220);

    }
    function closeLobbyModal() {

      clearInterval(lobbyTimer);

      document.getElementById('lobbyModal').classList.add('hidden');

    }
    function deployFromLobby() {

      closeLobbyModal();

      launchBattleRoyale(activeLobbyMode);

    }
    function registerTournament(name) {

      const btn = document.getElementById('registerGrandPrixBtn');

      if (btn) {

        btn.textContent = 'REGISTERED ✓';

        btn.className = 'px-5 py-2.5 bg-emerald-500/25 text-emerald-300 border border-emerald-400/60 font-tech font-bold text-xs uppercase tracking-[0.18em] rounded cursor-pointer';

      }

      openLobbyModal(name, 'Qualifier Slot Confirmed! Ready to drop into tournament lobby.');

    }
    function claimSeason09Pass() {

      seasonPassUnlocked = true;

      const btn = document.getElementById('claimSeasonPassBtn');

      if (btn) {

        btn.textContent = 'SEASON 09 UNLOCKED ✓';

        btn.className = 'bg-emerald-400 text-[#190536] font-tech font-bold uppercase text-sm tracking-[0.18em] px-8 py-4 rounded-[2px] shadow-[0_0_30px_rgba(52,211,153,0.6)] cursor-pointer shrink-0';

      }

      const badge = document.getElementById('seasonPassActiveBadge');

      if (badge) badge.classList.remove('hidden');

      openLobbyModal('SEASON 09 VIP ARENA', 'Cyber-Violet Gear & +100 Max Shield Bonus Activated!');

    }
    document.addEventListener('keydown', (e) => {

      if (e.key === 'Escape') {

        closeDrawer();

        closeLobbyModal();

        if (!document.getElementById('settingsModal').classList.contains('hidden')) {

          closeSettingsModal();

        } else if (hudEditorState.active) {

          exitHudLayoutEditor(true);

        }

      }

    });
    // -----------------------------------------------------------------------

    // 1B. Custom HUD & Dual Virtual Joystick Settings Manager (localStorage)

    // -----------------------------------------------------------------------

    const STORAGE_KEY_SETTINGS = 'eto_br_custom_settings_v2';
    const DEFAULT_USER_SETTINGS = {

      hud: {

        globalScale: 100,

        globalOpacity: 100,

        showMinimap: true,

        showKillFeed: true,

        showBanners: true,

        elements: {

          vitals: { x: null, y: null, scale: 100, opacity: 100 },

          match: { x: null, y: null, scale: 100, opacity: 100 },

          radar: { x: null, y: null, scale: 100, opacity: 100 },

          leftJoy: { x: null, y: null, scale: 100, opacity: 100 },

          rightJoy: { x: null, y: null, scale: 100, opacity: 100 },

          touchActions: { x: null, y: null, scale: 100, opacity: 100 }

        }

      },

      joystick: {

        enabled: true, // Enabled by default so on-screen joysticks are always ready & playable

        mode: 'fixed',

        autoFire: true,

        size: 128,

        deadzone: 15

      }

    };
    function loadUserSettings() {

      try {

        const raw = localStorage.getItem(STORAGE_KEY_SETTINGS);

        if (!raw) return JSON.parse(JSON.stringify(DEFAULT_USER_SETTINGS));

        const parsed = JSON.parse(raw);

        return {

          hud: {

            ...DEFAULT_USER_SETTINGS.hud,

            ...(parsed.hud || {}),

            elements: {

              ...DEFAULT_USER_SETTINGS.hud.elements,

              ...((parsed.hud && parsed.hud.elements) || {})

            }

          },

          joystick: {

            ...DEFAULT_USER_SETTINGS.joystick,

            ...(parsed.joystick || {})

          }

        };

      } catch (e) {

        return JSON.parse(JSON.stringify(DEFAULT_USER_SETTINGS));

      }

    }
    let userSettings = loadUserSettings();
    function saveUserSettings() {

      try {

        localStorage.setItem(STORAGE_KEY_SETTINGS, JSON.stringify(userSettings));

      } catch (e) {}

    }
    const HUD_DEFAULT_ANCHORS = {

      vitals: { top: '12px', left: '12px', right: '', bottom: '', transform: '' },

      match: { top: '12px', left: '50%', right: '', bottom: '', transform: 'translateX(-50%)' },

      radar: { top: '12px', left: '', right: '12px', bottom: '', transform: '' },

      leftJoy: { top: '', left: '28px', right: '', bottom: '28px', transform: '' },

      rightJoy: { top: '', left: '', right: '28px', bottom: '28px', transform: '' },

      touchActions: { top: '', left: '', right: '26px', bottom: '172px', transform: '' }

    };
    function applyAllUserSettings() {

      const globalScale = (userSettings.hud.globalScale || 100) / 100;

      const globalOpacity = (userSettings.hud.globalOpacity || 100) / 100;
      document.querySelectorAll('.hud-customizable').forEach((el) => {

        const id = el.dataset.hudId;

        const cfg = userSettings.hud.elements[id] || { x: null, y: null, scale: 100, opacity: 100 };

        const elScale = ((cfg.scale || 100) / 100) * globalScale;

        const elOpacity = ((cfg.opacity || 100) / 100) * globalOpacity;
        if (cfg.x !== null && cfg.y !== null) {

          el.style.left = `${cfg.x}px`;

          el.style.top = `${cfg.y}px`;

          el.style.right = 'auto';

          el.style.bottom = 'auto';

          el.style.transform = `scale(${elScale})`;

        } else {

          const def = HUD_DEFAULT_ANCHORS[id];

          el.style.top = def.top;

          el.style.left = def.left;

          el.style.right = def.right;

          el.style.bottom = def.bottom;

          el.style.transform = `${def.transform} scale(${elScale})`.trim();

        }

        el.style.opacity = String(elOpacity);

      });
      const minimapWrap = document.getElementById('minimapWrapper');

      if (minimapWrap) minimapWrap.style.display = userSettings.hud.showMinimap ? '' : 'none';
      const killFeedEl = document.getElementById('killFeedContainer');

      if (killFeedEl) killFeedEl.style.display = userSettings.hud.showKillFeed ? '' : 'none';
      const bannerEl = document.getElementById('arenaBanner');

      if (bannerEl) bannerEl.style.display = userSettings.hud.showBanners ? '' : 'none';
      const joyEnabled = Boolean(userSettings.joystick.enabled);

      if (typeof brState !== 'undefined') {

        brState.touch.enabled = joyEnabled;

      }

      const touchLayer = document.getElementById('touchControlsLayer');

      const toggleBtn = document.getElementById('toggleTouchBtn');

      if (touchLayer) {

        if (joyEnabled) {

          touchLayer.classList.remove('hidden');

          if (toggleBtn) toggleBtn.textContent = 'Joy: ON';

        } else {

          touchLayer.classList.add('hidden');

          if (toggleBtn) toggleBtn.textContent = 'Joy: OFF';

        }

      }
      const joySize = userSettings.joystick.size || 128;

      const knobSize = Math.round(joySize * 0.38);

      ['leftJoyBase', 'rightJoyBase'].forEach(baseId => {

        const b = document.getElementById(baseId);

        if (b) {

          b.style.width = `${joySize}px`;

          b.style.height = `${joySize}px`;

        }

      });

      ['leftJoyKnob', 'rightJoyKnob'].forEach(knobId => {

        const k = document.getElementById(knobId);

        if (k) {

          k.style.width = `${knobSize}px`;

          k.style.height = `${knobSize}px`;

        }

      });
      const isFloating = userSettings.joystick.mode === 'floating';

      const floatL = document.getElementById('floatingLeftZone');

      const floatR = document.getElementById('floatingRightZone');

      if (floatL && floatR) {

        if (joyEnabled && isFloating && !hudEditorState.active) {

          floatL.classList.remove('hidden');

          floatR.classList.remove('hidden');

        } else {

          floatL.classList.add('hidden');

          floatR.classList.add('hidden');

        }

      }
      const dedicatedFireBtn = document.getElementById('touchDedicatedFireBtn');

      const rightTag = document.getElementById('rightJoyTag');

      if (dedicatedFireBtn && rightTag) {

        if (userSettings.joystick.autoFire) {

          dedicatedFireBtn.classList.add('hidden');

          rightTag.textContent = 'AIM+FIRE';

        } else {

          dedicatedFireBtn.classList.remove('hidden');

          rightTag.textContent = 'AIM ONLY';

        }

      }
      syncSettingsModalControls();

    }
    function syncSettingsModalControls() {

      const s = userSettings;

      const setVal = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };

      const setTxt = (id, t) => { const el = document.getElementById(id); if (el) el.textContent = t; };

      const setChk = (id, c) => { const el = document.getElementById(id); if (el) el.checked = c; };
      setVal('cfgGlobalScale', s.hud.globalScale);

      setTxt('cfgGlobalScaleVal', `${s.hud.globalScale}%`);

      setVal('cfgGlobalOpacity', s.hud.globalOpacity);

      setTxt('cfgGlobalOpacityVal', `${s.hud.globalOpacity}%`);

      setChk('cfgShowMinimap', s.hud.showMinimap);

      setChk('cfgShowKillFeed', s.hud.showKillFeed);

      setChk('cfgShowBanners', s.hud.showBanners);
      setChk('cfgJoyEnabled', s.joystick.enabled);

      setVal('cfgJoySize', s.joystick.size);

      setTxt('cfgJoySizeVal', `${s.joystick.size}px`);

      setVal('cfgJoyDeadzone', s.joystick.deadzone);

      setTxt('cfgJoyDeadzoneVal', `${s.joystick.deadzone}%`);
      const fixedBtn = document.getElementById('joyModeFixedBtn');

      const floatBtn = document.getElementById('joyModeFloatingBtn');

