        weapon.reloading = weapon.reloadTime;

        return;

      }
      weapon.ammo--;

      fighter.fireCooldown = weapon.fireRate;
      const muzzleDist = fighter.radius + 10;

      const mx = fighter.x + Math.cos(fighter.angle) * muzzleDist;

      const my = fighter.y + Math.sin(fighter.angle) * muzzleDist;
      for (let p = 0; p < weapon.pellets; p++) {

        const spreadOffset = (Math.random() - 0.5) * weapon.spread;

        const shotAngle = fighter.angle + spreadOffset;

        brState.bullets.push({

